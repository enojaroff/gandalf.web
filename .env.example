# Copy to .env and fill in the values. .env is gitignored (holds secrets).

# Port the Nuxt server listens on.
PORT=3000

# Base URL of the gandalf.api backend (the server proxy forwards to it).
API_ENDPOINT=http://localhost:8080/

# OAuth2 client of gandalf.api. Server side only: the /api proxy adds it to the
# routes that need it, the browser never receives it. Do not commit real values.
API_CLIENTID=your_client_id
API_CLIENTSECRET=your_client_secret

DEBUG=false
